{
  "manifest_version": 3,
  "name": "Quiz Pop — Exam Prep MCQs",
  "version": "1.0.0",
  "description": "Translucent MCQ quiz popups for General Knowledge, UPSC, KPSC/KAS and more — no AI, no tracking, content syncs automatically.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "scripts": [
      "vendor/browser-polyfill.js",
      "core/browser-api.js",
      "core/categories.js",
      "core/storage.js",
      "core/quiz-engine.js",
      "core/content-sync.js",
      "background/service-worker.js"
    ]
  },
  "permissions": ["storage", "alarms", "scripting", "activeTab"],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "quiz-pop-exam-prep@kinvtstudy.local",
      "strict_min_version": "115.0"
    }
  }
}
