{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kinvt-study",
  "version": "1.0.0",
  "identifier": "com.kinvtstudy.quiz",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "quiz",
        "title": "Kinvt-study",
        "url": "index.html",
        "width": 400,
        "height": 460,
        "resizable": false,
        "center": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
