{
  "name": "kinvt-study",
  "version": "1.0.0",
  "description": "Translucent MCQ quiz popups for competitive-exam prep — local-first, no AI",
  "author": "Vinayaka",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kinvtstudy.quiz",
    "productName": "Kinvt-study",
    "files": ["main.js", "preload.js", "ui/**/*", "!ui/_preview*"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Kinvt-study-portable.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}
